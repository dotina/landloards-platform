# Landloads — production environment template
# Copy to .env on the production host and fill in the real values.
# Never commit a populated copy.

# App
APP_ENV=production
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://landloads:CHANGE_ME@postgres:5432/landloads

# Redis (Sessions + arq + rate limit + OTP)
REDIS_URL=redis://redis:6379/0

# MinIO (object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=landloads
MINIO_USE_SSL=false

# Sentry (error reporting)
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# Auth (must be 32+ chars; generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=CHANGE_ME_WITH_REAL_SECRET_AT_LEAST_32_CHARS_LONG
PII_ENCRYPTION_KEY=CHANGE_ME_WITH_REAL_SECRET_AT_LEAST_32_CHARS_LONG

# Cookie / CSRF (production = HTTPS only)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=landloads.example.co.ke

# Notifications
NOTIFICATIONS_ENABLED=true
AT_USERNAME=landloads
AT_API_KEY=CHANGE_ME
AT_SENDER_ID=LANDLOADS
AT_BASE_URL=https://api.africastalking.com/version1
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=no-reply@landloads.example.co.ke

# M-Pesa Daraja (production)
MPESA_ENV=production
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_BUSINESS_SHORT_CODE=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_PAYBILL=CHANGE_ME
MPESA_CALLBACK_SECRET=CHANGE_ME_WITH_RANDOM_32_CHARS
MPESA_CALLBACK_BASE_URL=https://landloads.example.co.ke
MPESA_INITIATOR_NAME=CHANGE_ME
MPESA_INITIATOR_PASSWORD=CHANGE_ME

# Backups
BACKUP_BUCKET=landloads-backups
RETENTION_DAYS=14
